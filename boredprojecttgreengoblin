using System.Collections;

string player = "Goblin Slayer";
int playerHP = new Random().Next(3, 13);
string goblin = "Green Goblin";
int goblinHP = new Random().Next(2, 9);
bool escaped = false;

Console.WriteLine($"{player} encounters a {goblin}!");

while (playerHP > 0 && goblinHP > 0 && !escaped)
{
    Random rng = new Random();
    int dodgeNumber = rng.Next(1, 7);
    int attackNumber = rng.Next(1, 7);
    int goblinAttackNumber = rng.Next(1, 7);
    int goblinDodgeNumber = rng.Next(1, 7);
    int damageGoblin = rng.Next(1, 7);
    int damagePlayer = rng.Next(1, 9);

    Console.WriteLine($"\nYour HP: {playerHP} | {goblin} HP: {goblinHP}");
    Console.WriteLine("What do you want to do? (attack, run, healing potion, defend, grapple)");
    string action = Console.ReadLine().ToLower();

    switch (action)
    {
        case "attack":
            if (attackNumber >= goblinDodgeNumber)
            {
                Console.WriteLine($"You hit the {goblin}!");
                goblinHP -= damagePlayer;
                Console.WriteLine($"You dealt {damagePlayer} damage to the {goblin}.");
            }
            else
            {
                Console.WriteLine("You miss!!!");
            }
            if (goblinHP > 0)
            {
                if (goblinAttackNumber >= dodgeNumber)
                {
                    Console.WriteLine($"{goblin} attacks you!");
                    playerHP -= damageGoblin;
                    Console.WriteLine($"You took {damageGoblin} damage!");
                }
                else
                {
                    Console.WriteLine($"{goblin} missed the attack!");
                }
            }
            break;
        case "run":
            if (dodgeNumber >= 4)
            {
                Console.WriteLine("You successfully run away!!");
                escaped = true;
            }
            else
            {
                Console.WriteLine("You failed to run away!!");
                if (goblinAttackNumber >= dodgeNumber)
                {
                    playerHP -= damageGoblin;
                    Console.WriteLine($"{goblin} hit you for {damageGoblin} damage as you fled!");
                }
            }
            break;
        case "healing potion":
            int healAmount = rng.Next(1, 7);
            playerHP += healAmount;
            Console.WriteLine($"You used a healing potion and recovered {healAmount} HP!");
            Console.WriteLine($"You have {playerHP} HP remaining.");
            if (goblinAttackNumber >= dodgeNumber)
            {
                Console.WriteLine($"{goblin} attacks you!");
                playerHP -= damageGoblin;
                Console.WriteLine($"You took {damageGoblin} damage!");
            }
            else
            {
                Console.WriteLine($"{goblin} missed the attack!");
            }
            break;
        case "defend":
            if (dodgeNumber * 2 >= goblinAttackNumber)
            {
                Console.WriteLine("You successfully defended against the attack!");
            }
            else
            {
                playerHP -= damageGoblin;
                Console.WriteLine($"You took {damageGoblin} damage!");
                Console.WriteLine($"You have {playerHP} HP remaining.");
            }
            break;
        case "grapple":
            if (attackNumber >= goblinDodgeNumber)
            {
                Console.WriteLine($"You successfully grappled the {goblin}!");
                goblinHP -= damagePlayer * 2;
                Console.WriteLine($"You dealt {damagePlayer * 2} damage to the {goblin}!");
            }
            else
            {
                Console.WriteLine($"{goblin} broke free from your grapple! Gaining a free attack!");
                playerHP -= damageGoblin;
                Console.WriteLine($"You took {damageGoblin} damage!");
            }
            break;
        default:
            Console.WriteLine("Invalid action. Please try again.");
            break;
    }
}

if (escaped)
{
    Console.WriteLine("You escaped from the goblin!");
}
else if (playerHP <= 0)
{
    Console.WriteLine("You have been defeated by the goblin...");
}
else if (goblinHP <= 0)
{
    Console.WriteLine($"Congratulations! You have defeated the {goblin}!");
}
